# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# Run SQL migrations automatically on boot (set false when running multiple
# API replicas — migrate one of them or via `npm run migrate`).
RUN_MIGRATIONS=true

# ── PostgreSQL ────────────────────────────────────────────────────────────
DATABASE_URL=postgres://jaad:jaad@localhost:5432/jaad
DB_POOL_MAX=10
# Set true behind TLS-terminating proxies that require SSL (e.g. managed PG).
DB_SSL=false

# ── Webhook security (Module 1) ───────────────────────────────────────────
# Shared HMAC SHA-256 secret with the telecom gateway (WaafiPay/Telesom,
# Hormuud EVC Plus). The gateway signs the raw request body; we verify the
# `x-waafi-signature` or `x-signature` header against it.
TELECOM_WEBHOOK_SECRET=change-me-64-random-chars

# ── Device auth (POS terminals → /api/sync/outbox, /api/payments/stk-push)
# Comma-separated `apiKey:deviceId` pairs used to bootstrap/register
# terminals. Each terminal sends `x-device-key` + `x-device-id` headers.
DEVICE_API_KEYS=pos-key-hga-01:POS-HGA-01,pos-key-hga-02:POS-HGA-02

# ── EVC Plus (Hormuud) merchant STK gateway ───────────────────────────────
EVC_API_BASE_URL=https://api.evcplus.com
EVC_MERCHANT_ID=
EVC_API_KEY=
EVC_SECRET=
EVC_STK_ENDPOINT=/merchant/stk/push
# Public URL the gateway calls back for confirmation:
EVC_CALLBACK_URL=https://your-domain.example/api/payments/webhook

# ── Zaad (Telesom / WaafiPay e-Billing) merchant gateway ──────────────────
ZAAD_API_BASE_URL=https://api.zaad.com
ZAAD_MERCHANT_CODE=
ZAAD_SECRET=
ZAAD_STK_ENDPOINT=/api/merchant/stk
ZAAD_CALLBACK_URL=https://your-domain.example/api/payments/webhook

# When a provider's credentials are empty, the gateway client runs in
# SIMULATED mode (returns a fake invoice id, logs loudly). Useful for
# staging and load testing without live merchant accounts.

# ── SMS receipts (Module 3) ───────────────────────────────────────────────
# africastalking | telesom | hormuud | disabled
SMS_PROVIDER=africastalking
SMS_BUSINESS_NAME=KhatHub

# Africa's Talking
AT_API_KEY=
AT_USERNAME=
AT_FROM=KhatHub
AT_API_BASE_URL=https://api.africastalking.com/version1

# Telesom bulk SMS gateway
TELESOM_SMS_URL=
TELESOM_SMS_TOKEN=
TELESOM_SMS_SENDER=JAAD

# Hormuud local bulk SMS endpoint
HORMUUD_SMS_URL=
HORMUUD_SMS_TOKEN=
